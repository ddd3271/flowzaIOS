<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- iOS can only be built on a Mac (or a macOS CI runner), so it is added only there -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FlowzaMobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Flowza</ApplicationTitle>
    <!-- same package family as the desktop app, change if you publish it yourself -->
    <ApplicationId>com.crexx.flowza</ApplicationId>
    <ApplicationIdGuid>6E9B0B2E-6B3C-4A3F-9B0C-1C7B1F0E2A11</ApplicationIdGuid>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>

    <!-- don't stop the build on the harmless "newer MAUI workload available" notices -->
    <NoWarn>$(NoWarn);XC0022;XC0023;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the manifest points at @mipmap/appicon, so an icon file MUST exist or the Android build fails -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#161513" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#161513" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- version comes from the installed MAUI workload, so it can never disagree with it -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

</Project>
