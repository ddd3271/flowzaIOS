<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:FlowzaMobile.Pages"
       x:Class="FlowzaMobile.AppShell"
       Shell.FlyoutBehavior="Disabled"
       BackgroundColor="#0B0B10"
       Title="Flowza">

    <ShellContent Route="login" ContentTemplate="{DataTemplate pages:LoginPage}" />

    <TabBar Route="home">
        <ShellContent Title="Home" Route="playlists" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
